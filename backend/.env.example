# Environment Configuration
NODE_ENV=development
PORT=3001

# Database Configuration (Pulsemail PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vmail
DB_USER=vmail
DB_PASSWORD=your_vmail_password

# Email Server Configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_admin@domain.com
SMTP_PASS=your_admin_password

IMAP_HOST=localhost
IMAP_PORT=143
IMAP_SECURE=false

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# SpamAssassin Configuration
SPAMASSASSIN_HOST=localhost
SPAMASSASSIN_PORT=783

# OpenAI Configuration (for LLM features)
OPENAI_API_KEY=your_openai_api_key_here

# 2FA Configuration
APP_NAME=Pulsemail Client

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
