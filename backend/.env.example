# =============================================================================
# Environment
# =============================================================================
NODE_ENV=development
PORT=3001

# Serve the mock database instead of talking to a real server. Only honoured
# when NODE_ENV=development, so it can never activate in production.
USE_MOCK_DATA=true

# Log every SQL statement. Very noisy; for debugging only.
DB_DEBUG=false

# =============================================================================
# Databases
# =============================================================================
# iRedMail's vmail database. Postfix and Dovecot read this too, so the
# application only touches the documented iRedMail schema and never creates
# tables here. A read/write user on mailbox, domain, alias, forwardings,
# domain_admins and used_quota is enough; no DDL rights are needed.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vmail
DB_USER=vmail
DB_PASSWORD=your_vmail_password

# The application's own tables: preferences, 2FA, campaigns, automation, mail
# filters, identities and the impersonation audit trail. This user does need
# DDL rights, because the schema is created on first boot.
#
# Leave these unset and everything falls back to the vmail connection above,
# which reproduces the old single-database behaviour. Setting them is strongly
# recommended so an iRedMail upgrade can never collide with our tables.
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=pulsemail
APP_DB_USER=pulsemail
APP_DB_PASSWORD=your_app_db_password

DB_POOL_MAX=20
DB_CONNECT_TIMEOUT_MS=5000

# =============================================================================
# Outbound mail (Postfix)
# =============================================================================
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_admin@domain.com
SMTP_PASS=your_admin_password
SMTP_TLS_REJECT_UNAUTHORIZED=true

# =============================================================================
# Inbound mail (Dovecot IMAP)
# =============================================================================
IMAP_HOST=localhost
IMAP_PORT=143
IMAP_SECURE=false
IMAP_TLS_REJECT_UNAUTHORIZED=true

# Dovecot master user. The client logs into any mailbox as
# "<mailbox><separator><master user>" with the master password, which is what
# lets an admin read another user's mail without knowing their password, and
# what lets the client open a session from a JWT rather than a stored password.
# Requires a matching master passdb in dovecot.conf; see DEPLOYMENT.md.
IMAP_MASTER_USER=pulsemail-master
IMAP_MASTER_PASS=your_master_password
IMAP_MASTER_SEPARATOR=*

# IMAP connection pool
IMAP_MAX_CONNECTIONS=10
IMAP_IDLE_TTL_MS=30000
IMAP_CONN_TIMEOUT_MS=15000
IMAP_AUTH_TIMEOUT_MS=10000
IMAP_ACQUIRE_TIMEOUT_MS=20000

# =============================================================================
# Sieve (Dovecot Pigeonhole ManageSieve)
# =============================================================================
# Backs the mail filter rules and the vacation / out-of-office responder.
# Without this, filters are stored but never take effect on the server.
# Credentials default to the IMAP master user when left unset.
SIEVE_HOST=localhost
SIEVE_PORT=4190

# SIEVE_SECURE wraps the connection in TLS from the first byte (implicit TLS).
# SIEVE_STARTTLS upgrades a plaintext connection instead, and is the default.
SIEVE_SECURE=false
SIEVE_STARTTLS=true
SIEVE_TLS_REJECT_UNAUTHORIZED=true

SIEVE_MASTER_USER=
SIEVE_MASTER_PASS=
SIEVE_TIMEOUT_MS=15000

# Name of the managed script. Dovecot keeps user-authored scripts separate, so
# this only overwrites the one the application owns.
SIEVE_SCRIPT_NAME=pulsemail

# =============================================================================
# Unified (all-inboxes) admin view
# =============================================================================
UNIFIED_INBOX_CONCURRENCY=5
UNIFIED_INBOX_MAX_MAILBOXES=50
UNIFIED_INBOX_CACHE_TTL_MS=15000

# =============================================================================
# Authentication
# =============================================================================
# Must be at least 32 characters. Generate with: openssl rand -base64 48
# Changing it invalidates every existing session.
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# =============================================================================
# HTTP
# =============================================================================
# Number of reverse proxies in front of the app (1 for a single nginx). Without
# it every request appears to come from the proxy, so the rate limiter treats
# all users as one client and the first busy session locks everyone out.
# Prefer a count over "true", which would let a client forge X-Forwarded-For.
TRUST_PROXY=1

# Comma-separated origins allowed to call the API cross-origin. Leave empty
# when nginx serves the frontend and proxies /api from the same host, which is
# the layout in DEPLOYMENT.md and needs no CORS at all.
CORS_ORIGINS=

# =============================================================================
# Rate limiting
# =============================================================================
# Limits key on the authenticated mailbox where there is one, else the client
# address. The general limit is an abuse backstop: a webmail session issues one
# request per folder listing plus one per message opened, so a low ceiling
# breaks normal reading.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3000

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

SEND_RATE_LIMIT_WINDOW_MS=60000
SEND_RATE_LIMIT_MAX=20

# =============================================================================
# Optional integrations
# =============================================================================
SPAMASSASSIN_HOST=localhost
SPAMASSASSIN_PORT=783

# AI importance sorting, reply drafting and summaries are configured in the
# admin panel under "AI Sorting", not here: the endpoint, model and API key
# live in the llm_settings table so they can be changed without a restart.
#
# These two are only read once, to seed that table on first boot. After that
# the admin panel is authoritative and editing them has no effect.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Encrypts secrets that administrators type into the UI, currently the LLM API
# key. Falls back to JWT_SECRET when unset, which works but means rotating the
# JWT secret also invalidates the stored key and it has to be re-entered.
# Generate with: openssl rand -base64 48
SECRET_ENCRYPTION_KEY=

# Pacing of the background classifier. The daily message cap, batch size and
# how far back it looks are set in the admin panel; these only control how
# often it wakes up and how much it takes on per cycle.
CLASSIFY_INTERVAL_MS=300000
CLASSIFY_MAILBOXES_PER_CYCLE=5
CLASSIFY_SCAN_DEPTH=100

# =============================================================================
# Application
# =============================================================================
# Shown in authenticator apps when enrolling 2FA.
APP_NAME=Pulsemail Client
